# Django
SECRET_KEY=cambia-esta-clave
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost

# Base de datos: sqlite (default, db.sqlite3) o mysql (MariaDB)
DB_ENGINE=sqlite
DB_HOST=127.0.0.1
DB_NAME=nexsecure
DB_USER=nexsecure
DB_PASSWORD=
DB_PORT=3306

# Email (console imprime en terminal; usar smtp en produccion)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=no-reply@nexsecure.cl

# WhatsApp stub (calendario notify). 1 = log stub send; other/unset = no-op
WHATSAPP_ENABLED=0

# Finanzas (tasas Chile)
FINANZAS_PPM_RATE=0.0025
FINANZAS_IVA_RATE=0.19
